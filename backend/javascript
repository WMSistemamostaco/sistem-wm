const express = require("express");
const cors = require("cors");
require("dotenv").config();

const app = express();
app.use(express.json());

// CORS liberado para testes; depois restrinja ao domínio do seu frontend
app.use(cors({ origin: "*"}));

// Rota de saúde (teste)
app.get("/", (req, res) => {
  res.json({ ok: true, name: "Sistem WM API", time: new Date().toISOString() });
});

// Exemplo de "ordens" em memória (placeholder)
let ordens = [];
app.get("/ordens", (req, res) => res.json(ordens));
app.post("/ordens", (req, res) => {
  const nova = { id: Date.now(), ...req.body, status: req.body.status || "PENDENTE" };
  ordens.push(nova);
  res.status(201).json(nova);
});

const PORT = process.env.PORT || 3001;
app.listen(PORT, () => console.log(`API rodando na porta ${PORT}`));
